<root>
	<windowclass name="charsheet_abilities_contents" merge="join">
		<sheetdata>
			<sub_content_top name="martialadvantages" insertbefore="traits">
				<class>charsheet_abilities_martialadvantages</class>
			</sub_content_top>
		</sheetdata>
	</windowclass>
	<windowclass name="charsheet_abilities_martialadvantages" copy="charsheet_abilities_list">
		<sheetdata>
			<label_charframetop name="header">
				<static textres="char_abilities_label_martialadvantages" />
				<icons>char_abilities</icons>
			</label_charframetop>
			<list_content_noscroll_alternating_top name="list">
				<datasource>.martialadvantages</datasource>
				<class>charsheet_ability_martialadvantage</class>
				<sortby><control>name</control></sortby>
			</list_content_noscroll_alternating_top>
		</sheetdata>
	</windowclass>
	<windowclass name="charsheet_ability_martialadvantage" copy="charsheet_ability_item">
		<sheetdata>
			<linkc_listitem_left name="shortcut">
				<class>reference_martialadvantage</class>
			</linkc_listitem_left>
		</sheetdata>
	</windowclass>
</root>
